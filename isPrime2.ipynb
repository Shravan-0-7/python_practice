   ],
   "source": [
    "num = int(input(\"Input any number: \"))\n",
    "flag = 0\n",
    "for i in range (2, (num//2)+1):\n",
    "    if(num%i == 0):\n",
    "        flag = 1\n",
    "        break\n",
    "\n",
    "if flag==1:\n",
    "    print(\"Number is not Prime\")\n",
    "else:\n",
    "    print(\"Number is PRIME\")"
   ]
